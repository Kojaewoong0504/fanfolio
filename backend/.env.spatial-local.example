# Copy these values into backend/.env for local real-model spatial testing.
APP_ENV=development
DATABASE_URL=sqlite:///./fanfolio.db
AUTO_CREATE_SCHEMA=false
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# Keep local API testing dependency-free. Set TASK_QUEUE_MODE=celery only when
# you intentionally run Redis and a Celery worker as a separate local stack.
TASK_QUEUE_MODE=inline

SPATIAL_SCENE_PROVIDER=http
SPATIAL_SCENE_AI_URL=http://localhost:8080/generate
SPATIAL_SCENE_AI_TOKEN=local-spatial-worker-token
SPATIAL_SCENE_AI_TIMEOUT_SECONDS=180
