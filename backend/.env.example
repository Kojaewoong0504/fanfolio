APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./fanfolio.db
DATABASE_STATEMENT_CACHE_SIZE=100
AUTO_CREATE_SCHEMA=true
SEED_DEMO_CATALOG=false
# One-time, idempotent repair for the packaged demo card only. It uploads the
# bundled image to the configured private storage and links the published card.
REPAIR_DEMO_CARD_ASSETS=false
FRONTEND_ORIGINS=http://localhost:4174,http://localhost:4175,http://localhost:5173,http://127.0.0.1:4174,http://127.0.0.1:4175,http://127.0.0.1:5173
FRONTEND_PREVIEW_PROJECTS=
FRONTEND_PREVIEW_DOMAIN=
STORAGE_DIR=./storage
STORAGE_BACKEND=local
# Cloudflare R2 uses the S3-compatible API. Keep these values server-only.
# STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=<cloudflare-account-id>
# R2_BUCKET=fanfolio-assets
# R2_ACCESS_KEY_ID=<r2-access-key>
# R2_SECRET_ACCESS_KEY=<r2-secret-key>
# Hosted Supabase Storage uses STORAGE_BACKEND=supabase and the remote S3
# values documented in docs/SUPABASE_SETUP.md.
# STORAGE_BACKEND=supabase
# S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=<project-region>
# S3_BUCKET=fanfolio-assets
# S3_ACCESS_KEY_ID=<server-only-s3-access-key>
# S3_SECRET_ACCESS_KEY=<server-only-s3-secret-key>
S3_ENDPOINT_URL=
S3_REGION=ap-northeast-2
S3_BUCKET=
S3_KEY_PREFIX=fanfolio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ASSET_SCAN_MODE=basic
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=5
FRONTEND_URL=http://localhost:5173
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-12-character-secret
# Development-only browser verification credentials (not used in hosted environments)
LOCAL_ADMIN_EMAIL=local-admin@example.com
LOCAL_ADMIN_PASSWORD=local-admin-password-2026
LOCAL_ARTIST_STUDIO_USERNAME=local-artist-studio
LOCAL_ARTIST_STUDIO_PASSWORD=local-artist-password-2026
LOCAL_ARTIST_STUDIO_ARTIST_ID=artist_nova3
JWT_ACCESS_SECRET=dev-access-secret-change-me-32-bytes
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32-bytes
JWT_ISSUER=fanfolio
JWT_AUDIENCE=fanfolio-api
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_SECONDS=2592000
OAUTH_FRONTEND_CALLBACK_URL=http://localhost:5173/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/auth/oauth/kakao/callback
OAUTH_STATE_TTL_SECONDS=600
OAUTH_EXCHANGE_CODE_TTL_SECONDS=60
MAIL_DELIVERY_MODE=console
MAIL_FROM=Fanfolio <no-reply@localhost>
# Resend is opt-in. A verified sender domain is required before production
# delivery; keep console mode locally until that domain is available.
# MAIL_DELIVERY_MODE=resend
# RESEND_API_KEY=<server-only-resend-api-key>
# RESEND_BASE_URL=https://api.resend.com

# Firebase Cloud Messaging is opt-in. Keep console mode until device-token
# registration is enabled for the client. These values are server-only.
PUSH_DELIVERY_MODE=console
# PUSH_DELIVERY_MODE=fcm
# FIREBASE_PROJECT_ID=fnafolio
# FIREBASE_CLIENT_EMAIL=<firebase-service-account-client-email>
# FIREBASE_PRIVATE_KEY=<firebase-service-account-private-key>
# FIREBASE_TOKEN_URL=https://oauth2.googleapis.com/token
# FIREBASE_API_BASE_URL=https://fcm.googleapis.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
TASK_QUEUE_MODE=inline
# Failed growth events use bounded exponential backoff before dead-lettering.
ENGAGEMENT_EVENT_MAX_ATTEMPTS=5
ENGAGEMENT_EVENT_RETRY_BASE_SECONDS=30
ENGAGEMENT_EVENT_RETRY_MAX_SECONDS=3600
UPLOAD_CLEANUP_INTERVAL_SECONDS=900
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REDIS_URL=redis://localhost:6379/1
