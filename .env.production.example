APP_ENV=production
AUTO_CREATE_SCHEMA=false
DATA_PROTECTION_KEY=replace-with-a-random-32-character-secret
# Set true only for the first deployment of a new durable database, then turn it off.
ALLOW_DATA_BOOTSTRAP=false
# Sandbox point issuance is disabled in production; enable only in a hosted QA environment.
ALLOW_SANDBOX_POINT_CHARGES=false

# Use a URL-encoded password in DATABASE_URL when it contains reserved URL characters.
DATABASE_URL=postgresql+asyncpg://fanfolio:replace-with-a-real-password@postgres:5432/fanfolio
# Optional dedicated API role. Set it to a non-owner role and run migrations
# with a database owner so the API cannot rewrite the point ledger.
DATABASE_APP_ROLE=fanfolio_api
POSTGRES_DB=fanfolio
POSTGRES_USER=fanfolio
POSTGRES_PASSWORD=replace-with-a-real-password

FRONTEND_URL=https://app.fanfolio.example
FRONTEND_ORIGINS=https://app.fanfolio.example,https://admin.fanfolio.example,https://studio.fanfolio.example

# Production uses an S3-compatible object store for direct browser uploads.
STORAGE_BACKEND=r2
STORAGE_DIR=/var/lib/fanfolio/storage
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET=fanfolio-production
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
S3_KEY_PREFIX=fanfolio
DOWNLOAD_SIGNING_SECRET=replace-with-a-long-random-secret

# Uploads fail closed when the malware scanner is unavailable.
ASSET_SCAN_MODE=clamav
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=5

MAIL_DELIVERY_MODE=resend
RESEND_API_KEY=replace-with-resend-api-key
RESEND_BASE_URL=https://api.resend.com
MAIL_FROM=Fanfolio <no-reply@fanfolio.example>
PUSH_DELIVERY_MODE=fcm
FIREBASE_PROJECT_ID=fnafolio
FIREBASE_CLIENT_EMAIL=replace-with-firebase-service-account-email
FIREBASE_PRIVATE_KEY=replace-with-firebase-private-key
FIREBASE_TOKEN_URL=https://oauth2.googleapis.com/token
FIREBASE_API_BASE_URL=https://fcm.googleapis.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

TASK_QUEUE_MODE=celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_URL=redis://redis:6379/1
UPLOAD_CLEANUP_INTERVAL_SECONDS=900
POINT_RECONCILIATION_INTERVAL_SECONDS=300

# Bind the API only to localhost when a TLS reverse proxy runs on the same host.
API_BIND=127.0.0.1
API_HOST_PORT=8000
