APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./fanfolio.db
AUTO_CREATE_SCHEMA=true
FRONTEND_ORIGINS=http://localhost:4174,http://localhost:4175,http://localhost:5173,http://127.0.0.1:4174,http://127.0.0.1:4175,http://127.0.0.1:5173
STORAGE_DIR=./storage
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_REGION=ap-northeast-2
S3_BUCKET=
S3_KEY_PREFIX=fanfolio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ASSET_SCAN_MODE=basic
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=5
FRONTEND_URL=http://localhost:5173
MAIL_DELIVERY_MODE=console
MAIL_FROM=Fanfolio <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
TASK_QUEUE_MODE=inline
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REDIS_URL=redis://localhost:6379/1
